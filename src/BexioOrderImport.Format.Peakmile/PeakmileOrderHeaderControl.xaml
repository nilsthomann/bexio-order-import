<UserControl x:Class="BexioOrderImport.Format.Peakmile.PeakmileOrderHeaderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:BexioOrderImport.Format.Peakmile.Resources">
    <!-- The import page spaces the views, so the card has no margin -->
    <Border Style="{StaticResource CardBorderStyle}" Margin="0">
        <StackPanel>
            <TextBlock Text="{x:Static res:PeakmileTranslations.Import_OrderHeader}" Style="{StaticResource SectionHeaderTextBlockStyle}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,4">
                    <TextBlock Text="{x:Static res:PeakmileTranslations.Import_Customer}" Style="{StaticResource MutedTextBlockStyle}"/>
                    <TextBlock Text="{Binding CompanyName}" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,4">
                    <TextBlock Text="{x:Static res:PeakmileTranslations.Import_Address}" Style="{StaticResource MutedTextBlockStyle}"/>
                    <TextBlock Text="{Binding Address}" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Grid.Row="0" Margin="0,4">
                    <TextBlock Text="{x:Static res:PeakmileTranslations.Import_Email}" Style="{StaticResource MutedTextBlockStyle}"/>
                    <TextBlock Text="{Binding Email}" FontWeight="SemiBold"/>
                </StackPanel>

                <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,4">
                    <TextBlock Text="{x:Static res:PeakmileTranslations.Import_Buyer}" Style="{StaticResource MutedTextBlockStyle}"/>
                    <TextBlock Text="{Binding BuyerName}" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Grid.Row="1" Margin="0,4">
                    <TextBlock Text="{x:Static res:PeakmileTranslations.Import_Conditions}" Style="{StaticResource MutedTextBlockStyle}"/>
                    <TextBlock Text="{Binding PaymentTerms}" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Grid.Row="1" Margin="0,4">
                    <TextBlock Text="{x:Static res:PeakmileTranslations.Import_OrderNumber}" Style="{StaticResource MutedTextBlockStyle}"/>
                    <TextBlock Text="{Binding OrderNumber}" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Grid.Row="1" Margin="0,4">
                    <TextBlock Text="{x:Static res:PeakmileTranslations.Import_CustomerNumber}" Style="{StaticResource MutedTextBlockStyle}"/>
                    <TextBlock Text="{Binding CustomerNumber}" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
