<UserControl x:Class="BexioOrderImport.Format.Peakmile.PeakmilePositionsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:BexioOrderImport.Format.Peakmile.Resources"
             xmlns:wpf="clr-namespace:BexioOrderImport.Abstractions.Wpf;assembly=BexioOrderImport.Abstractions.Wpf">
    <!-- Positions and totals. The import page spaces the views, so the card has no margin -->
    <Border Style="{StaticResource CardBorderStyle}" Margin="0">
        <Grid>
            <Grid.Resources>
                <wpf:BindingProxy x:Key="Proxy" Data="{Binding}"/>
            </Grid.Resources>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="{x:Static res:PeakmileTranslations.Import_PositionsHeader}" Style="{StaticResource SectionHeaderTextBlockStyle}" Grid.Row="0"/>

            <DataGrid ItemsSource="{Binding Positions}" Grid.Row="1"
                      IsReadOnly="True"
                      CanUserReorderColumns="False" CanUserResizeColumns="False"
                      CanUserSortColumns="False"
                      Focusable="False">
                <DataGrid.ItemContainerStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Focusable" Value="False"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.ItemContainerStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                        <Setter Property="Focusable" Value="False"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{x:Static res:PeakmileTranslations.Import_ColArtNum}" Binding="{Binding ArticleNumber}" Width="70" ElementStyle="{StaticResource DataGridCellTextBlockStyle}"/>
                    <DataGridTextColumn Header="{x:Static res:PeakmileTranslations.Import_ColName}" Binding="{Binding ArticleName}" Width="2*" ElementStyle="{StaticResource DataGridCellTextBlockStyle}"/>
                    <DataGridTextColumn Header="{x:Static res:PeakmileTranslations.Import_ColColor}" Binding="{Binding Color}" Width="110" ElementStyle="{StaticResource DataGridCellTextBlockStyle}"/>
                    <DataGridTextColumn Header="{x:Static res:PeakmileTranslations.Import_ColCategory}" Binding="{Binding SizeCategory}" Width="100" ElementStyle="{StaticResource DataGridCellTextBlockStyle}"/>
                    <DataGridTemplateColumn Header="{x:Static res:PeakmileTranslations.Import_ColSize}" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid Background="Transparent"
                                      ToolTip="{Binding Size, Converter={StaticResource HtmlToNewLineConverter}}"
                                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <TextBlock Text="{Binding Size, Converter={StaticResource HtmlToNewLineConverter}}"
                                               TextWrapping="Wrap" VerticalAlignment="Center" Margin="4,2"/>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{x:Static res:PeakmileTranslations.Import_ColQuantity}" Binding="{Binding Quantity}" Width="70" ElementStyle="{StaticResource DataGridCellTextBlockStyle}"/>
                    <DataGridTextColumn Header="{x:Static res:PeakmileTranslations.Import_ColUnitPrice}" Binding="{Binding UnitPrice, StringFormat=F2}" Width="95" ElementStyle="{StaticResource DataGridCellTextBlockStyle}"
                                        Visibility="{Binding Data.IsRowDiscountEnabled, Source={StaticResource Proxy}, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                    <DataGridTextColumn Header="{x:Static res:PeakmileTranslations.Import_ColGrossPrice}" Binding="{Binding GrossUnitPrice, StringFormat=F2}" Width="85" ElementStyle="{StaticResource DataGridCellTextBlockStyle}"
                                        Visibility="{Binding Data.IsRowDiscountEnabled, Source={StaticResource Proxy}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <DataGridTextColumn Header="{x:Static res:PeakmileTranslations.Import_ColDiscount}" Binding="{Binding DiscountPercent, StringFormat=G}" Width="75" ElementStyle="{StaticResource DataGridCellTextBlockStyle}"
                                        Visibility="{Binding Data.IsRowDiscountEnabled, Source={StaticResource Proxy}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <DataGridTextColumn Header="{x:Static res:PeakmileTranslations.Import_ColNetPrice}" Binding="{Binding NetUnitPrice, StringFormat=F2}" Width="85" ElementStyle="{StaticResource DataGridCellTextBlockStyle}"
                                        Visibility="{Binding Data.IsRowDiscountEnabled, Source={StaticResource Proxy}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <DataGridTextColumn Header="{x:Static res:PeakmileTranslations.Import_ColTotalPrice}" Binding="{Binding TotalPrice, StringFormat=F2, Mode=OneWay}" Width="95" ElementStyle="{StaticResource DataGridCellTextBlockStyle}"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Totals -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                <TextBlock Text="{x:Static res:PeakmileTranslations.Preview_TotalArticles}" FontWeight="Medium" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding TotalQuantity}" FontWeight="SemiBold"/>

                <TextBlock Text="{x:Static res:PeakmileTranslations.Preview_TotalGross}" FontWeight="Medium" Foreground="{StaticResource TextMutedBrush}" Margin="16,0,6,0"/>
                <TextBlock Text="{Binding TotalGrossAmount, StringFormat={}{0:F2} CHF}" FontWeight="SemiBold"/>

                <TextBlock Text="{x:Static res:PeakmileTranslations.Preview_TotalDiscount}" FontWeight="Medium" Foreground="{StaticResource TextMutedBrush}" Margin="16,0,6,0"/>
                <TextBlock Text="{Binding DiscountPercent, StringFormat={}{0}%}" FontWeight="SemiBold" Foreground="{StaticResource ErrorBrush}"/>

                <TextBlock Text="{x:Static res:PeakmileTranslations.Preview_TotalNet}" FontWeight="Bold" Margin="16,0,6,0"/>
                <TextBlock Text="{Binding TotalNetAmount, StringFormat={}{0:F2} CHF}" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
