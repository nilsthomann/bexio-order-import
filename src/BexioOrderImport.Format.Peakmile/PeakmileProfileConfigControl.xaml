<UserControl x:Class="BexioOrderImport.Format.Peakmile.PeakmileProfileConfigControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:BexioOrderImport.Format.Peakmile.Resources">
    <UserControl.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
        </Style>
    </UserControl.Resources>

    <StackPanel>

        <!-- 1. Worksheet and season -->
        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{x:Static res:PeakmileTranslations.Settings_WorksheetSection}" Style="{StaticResource SectionHeaderTextBlockStyle}"/>

                <Grid Margin="0,8,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static res:PeakmileTranslations.Settings_WorksheetLabel}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBox Grid.Column="1" Text="{Binding WorksheetIndex, UpdateSourceTrigger=PropertyChanged}" Width="100" HorizontalAlignment="Left"/>
                </Grid>

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static res:PeakmileTranslations.Settings_SeasonCodeLabel}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBox Grid.Column="1" Text="{Binding SeasonCode, UpdateSourceTrigger=PropertyChanged}" Width="200" HorizontalAlignment="Left"/>
                </Grid>

                <Grid Margin="0,4,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{x:Static res:PeakmileTranslations.Settings_SeasonFallbackCodesLabel}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBox Grid.Column="1" Text="{Binding SeasonFallbackCodes, UpdateSourceTrigger=PropertyChanged}" Width="200" HorizontalAlignment="Left"/>
                    <TextBlock Text="{x:Static res:PeakmileTranslations.Settings_SeasonFallbackCodesHint}" Style="{StaticResource MutedTextBlockStyle}"
                               Grid.Row="1" Grid.Column="1" Margin="0,4,0,0" FontStyle="Italic"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 2. Header cells -->
        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{x:Static res:PeakmileTranslations.Settings_HeaderSection}" Style="{StaticResource SectionHeaderTextBlockStyle}"/>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,12">
                        <TextBlock Text="{x:Static res:PeakmileTranslations.Settings_CellCustomerName}" Style="{StaticResource MutedTextBlockStyle}"/>
                        <TextBox Text="{Binding CompanyNameCell, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,8,12">
                        <TextBlock Text="{x:Static res:PeakmileTranslations.Settings_CellStreet}" Style="{StaticResource MutedTextBlockStyle}"/>
                        <TextBox Text="{Binding StreetCell, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,8,12">
                        <TextBlock Text="{x:Static res:PeakmileTranslations.Settings_CellZipCodeCity}" Style="{StaticResource MutedTextBlockStyle}"/>
                        <TextBox Text="{Binding ZipCityCell, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="3" Margin="0,0,0,12">
                        <TextBlock Text="{x:Static res:PeakmileTranslations.Settings_CellEmail}" Style="{StaticResource MutedTextBlockStyle}"/>
                        <TextBox Text="{Binding BuyerEmailCell, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,12">
                        <TextBlock Text="{x:Static res:PeakmileTranslations.Settings_CellBuyerName}" Style="{StaticResource MutedTextBlockStyle}"/>
                        <TextBox Text="{Binding BuyerNameCell, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,8,12">
                        <TextBlock Text="{x:Static res:PeakmileTranslations.Settings_CellPaymentTerms}" Style="{StaticResource MutedTextBlockStyle}"/>
                        <TextBox Text="{Binding PaymentTermsCell, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,8,12">
                        <TextBlock Text="{x:Static res:PeakmileTranslations.Settings_CellDiscount}" Style="{StaticResource MutedTextBlockStyle}"/>
                        <TextBox Text="{Binding DiscountCell, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <CheckBox x:Name="EnableOrderNumberCheckBox" Grid.Row="2" Grid.Column="0"
                              Content="{x:Static res:PeakmileTranslations.Settings_EnableOrderNumber}"
                              IsChecked="{Binding EnableOrderNumber}"
                              VerticalAlignment="Center" Margin="0,16,8,0"
                              Foreground="{StaticResource TextBrush}" FontWeight="Medium"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="{x:Static res:PeakmileTranslations.Settings_CellOrderNumber}" Style="{StaticResource MutedTextBlockStyle}"/>
                        <TextBox Text="{Binding OrderNumberCell, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding ElementName=EnableOrderNumberCheckBox, Path=IsChecked}"/>
                    </StackPanel>
                    <CheckBox x:Name="EnableCustomerNumberCheckBox" Grid.Row="2" Grid.Column="2"
                              Content="{x:Static res:PeakmileTranslations.Settings_EnableCustomerNumber}"
                              IsChecked="{Binding EnableCustomerNumber}"
                              VerticalAlignment="Center" Margin="0,16,8,0"
                              Foreground="{StaticResource TextBrush}" FontWeight="Medium"/>
                    <StackPanel Grid.Row="2" Grid.Column="3">
                        <TextBlock Text="{x:Static res:PeakmileTranslations.Settings_CellCustomerNumber}" Style="{StaticResource MutedTextBlockStyle}"/>
                        <TextBox Text="{Binding CustomerNumberCell, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding ElementName=EnableCustomerNumberCheckBox, Path=IsChecked}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 3. Size matrix -->
        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{x:Static res:PeakmileTranslations.Settings_MatrixSection}" Style="{StaticResource SectionHeaderTextBlockStyle}"/>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="{x:Static res:PeakmileTranslations.Settings_MatrixStart}" Style="{StaticResource MutedTextBlockStyle}"/>
                        <TextBox Text="{Binding MatrixStartRow, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="{x:Static res:PeakmileTranslations.Settings_MatrixEnd}" Style="{StaticResource MutedTextBlockStyle}"/>
                        <TextBox Text="{Binding MatrixEndRow, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                        <TextBlock Text="{x:Static res:PeakmileTranslations.Settings_MatrixCategoryCol}" Style="{StaticResource MutedTextBlockStyle}"/>
                        <TextBox Text="{Binding MatrixCategoryColumn, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="0,0,8,0">
                        <TextBlock Text="{x:Static res:PeakmileTranslations.Settings_MatrixStartSizeCol}" Style="{StaticResource MutedTextBlockStyle}"/>
                        <TextBox Text="{Binding MatrixStartSizeColumn, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="{x:Static res:PeakmileTranslations.Settings_MatrixEndSizeCol}" Style="{StaticResource MutedTextBlockStyle}"/>
                        <TextBox Text="{Binding MatrixEndSizeColumn, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 4. Data columns -->
        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{x:Static res:PeakmileTranslations.Settings_ColsSection}" Style="{StaticResource SectionHeaderTextBlockStyle}"/>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,12">
                        <TextBlock Text="{x:Static res:PeakmileTranslations.Settings_RowStart}" Style="{StaticResource MutedTextBlockStyle}"/>
                        <TextBox Text="{Binding DataStartRow, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,8,12">
                        <TextBlock Text="{x:Static res:PeakmileTranslations.Settings_ColArtNum}" Style="{StaticResource MutedTextBlockStyle}"/>
                        <TextBox Text="{Binding ArticleNumberColumn, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,8,12">
                        <TextBlock Text="{x:Static res:PeakmileTranslations.Settings_ColName}" Style="{StaticResource MutedTextBlockStyle}"/>
                        <TextBox Text="{Binding ArticleNameColumn, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="3" Margin="0,0,8,12">
                        <TextBlock Text="{x:Static res:PeakmileTranslations.Settings_ColColor}" Style="{StaticResource MutedTextBlockStyle}"/>
                        <TextBox Text="{Binding ColorColumn, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="4" Margin="0,0,0,12">
                        <TextBlock Text="{x:Static res:PeakmileTranslations.Settings_ColSizeCategory}" Style="{StaticResource MutedTextBlockStyle}"/>
                        <TextBox Text="{Binding CategoryColumn, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="{x:Static res:PeakmileTranslations.Settings_ColStartQty}" Style="{StaticResource MutedTextBlockStyle}"/>
                        <TextBox Text="{Binding StartQtyColumn, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="{x:Static res:PeakmileTranslations.Settings_ColEndQty}" Style="{StaticResource MutedTextBlockStyle}"/>
                        <TextBox Text="{Binding EndQtyColumn, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,8,0">
                        <TextBlock Text="{x:Static res:PeakmileTranslations.Settings_ColUnitPrice}" Style="{StaticResource MutedTextBlockStyle}"/>
                        <TextBox Text="{Binding UnitPriceColumn, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <CheckBox x:Name="EnableRowDiscountCheckBox" Grid.Row="1" Grid.Column="3"
                              Content="{x:Static res:PeakmileTranslations.Settings_EnableRowDiscount}"
                              IsChecked="{Binding EnableRowDiscount}"
                              VerticalAlignment="Center" Margin="0,16,8,0"
                              Foreground="{StaticResource TextBrush}" FontWeight="Medium"/>
                    <StackPanel Grid.Row="1" Grid.Column="4">
                        <TextBlock Text="{x:Static res:PeakmileTranslations.Settings_ColRowDiscount}" Style="{StaticResource MutedTextBlockStyle}"/>
                        <TextBox Text="{Binding RowDiscountColumn, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding ElementName=EnableRowDiscountCheckBox, Path=IsChecked}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 5. Texts and templates -->
        <Border Style="{StaticResource CardBorderStyle}">
            <StackPanel>
                <TextBlock Text="{x:Static res:PeakmileTranslations.Settings_TextTemplatesSection}" Style="{StaticResource SectionHeaderTextBlockStyle}"/>

                <StackPanel Margin="0,8,0,12">
                    <TextBlock Text="{x:Static res:PeakmileTranslations.Settings_DefaultOrderNameLabel}" Margin="0,0,0,4" FontWeight="Medium"/>
                    <TextBox Text="{Binding DefaultOrderName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>
                    <TextBlock Text="{x:Static res:PeakmileTranslations.Settings_DefaultOrderNameHint}" Style="{StaticResource MutedTextBlockStyle}" FontStyle="Italic"/>
                </StackPanel>

                <!-- Position grouping (segmented control) -->
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="{x:Static res:PeakmileTranslations.Settings_PositionGroupingModeLabel}" Margin="0,0,0,6" FontWeight="Medium"/>
                    <Border HorizontalAlignment="Stretch" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                            CornerRadius="6" Background="Transparent" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <RadioButton Grid.Column="0"
                                         Content="{x:Static res:PeakmileTranslations.Settings_PositionGroupingSingle}"
                                         GroupName="PositionGroupingModeGroup"
                                         IsChecked="{Binding IsSinglePosition}"
                                         Style="{StaticResource SegmentedRadioButtonLeftStyle}"/>
                            <Rectangle Grid.Column="1" Fill="{StaticResource AccentBrush}"/>
                            <RadioButton Grid.Column="2"
                                         Content="{x:Static res:PeakmileTranslations.Settings_PositionGroupingGrouped}"
                                         GroupName="PositionGroupingModeGroup"
                                         IsChecked="{Binding IsGroupedPositions}"
                                         Style="{StaticResource SegmentedRadioButtonRightStyle}"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Single position template -->
                <StackPanel Margin="0,0,0,12" Visibility="{Binding IsGroupedPositions, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <TextBlock Text="{x:Static res:PeakmileTranslations.Settings_PositionTextTemplateLabel}" Margin="0,0,0,4" FontWeight="Medium"/>
                    <TextBox Text="{Binding SinglePositionTextTemplate, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>
                    <TextBlock Text="{x:Static res:PeakmileTranslations.Settings_SinglePositionTextTemplateHint}" Style="{StaticResource MutedTextBlockStyle}" FontStyle="Italic"/>
                </StackPanel>

                <!-- Grouped position templates -->
                <StackPanel Margin="0,0,0,12" Visibility="{Binding IsGroupedPositions, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="{x:Static res:PeakmileTranslations.Settings_PositionTextTemplateLabel}" Margin="0,0,0,4" FontWeight="Medium"/>
                        <TextBox Text="{Binding GroupedPositionTextTemplate, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>
                        <TextBlock Text="{x:Static res:PeakmileTranslations.Settings_GroupedPositionTextTemplateHint}" Style="{StaticResource MutedTextBlockStyle}" FontStyle="Italic"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{x:Static res:PeakmileTranslations.Settings_SizeRowTemplateLabel}" Margin="0,0,0,4" FontWeight="Medium"/>
                        <TextBox Text="{Binding SizeRowTemplate, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>
                        <TextBlock Text="{x:Static res:PeakmileTranslations.Settings_SizeRowTemplateHint}" Style="{StaticResource MutedTextBlockStyle}" FontStyle="Italic"/>
                    </StackPanel>
                </StackPanel>

                <!-- Discount position template -->
                <StackPanel Margin="0,0,0,4">
                    <TextBlock Text="{x:Static res:PeakmileTranslations.Settings_DiscountPositionTextTemplateLabel}" Margin="0,0,0,4" FontWeight="Medium"/>
                    <TextBox Text="{Binding DiscountPositionTextTemplate, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>
                    <TextBlock Text="{x:Static res:PeakmileTranslations.Settings_DiscountPositionTextTemplateHint}" Style="{StaticResource MutedTextBlockStyle}" FontStyle="Italic"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
