<Window x:Class="BexioOrderImport.Wpf.Views.CustomDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        ShowInTaskbar="False">
    <Grid>
        <Rectangle Fill="{StaticResource DialogBackdropBrush}"/>

        <!-- Card in the style of the import success dialog -->
        <Border Width="440" Style="{StaticResource DialogCardStyle}">
            <StackPanel>
                <!-- Icon of the dialog type, pops in like the success check -->
                <Grid Width="64" Height="64" HorizontalAlignment="Center" Margin="0,0,0,20" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                    </Grid.RenderTransform>
                    <Grid.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                     From="0.2" To="1.0" Duration="0:0:0.4">
                                        <DoubleAnimation.EasingFunction>
                                            <BackEase EasingMode="EaseOut" Amplitude="0.7"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                     From="0.2" To="1.0" Duration="0:0:0.4">
                                        <DoubleAnimation.EasingFunction>
                                            <BackEase EasingMode="EaseOut" Amplitude="0.7"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Grid.Triggers>
                    <Ellipse x:Name="IconCircle" Width="64" Height="64">
                        <Ellipse.Effect>
                            <DropShadowEffect x:Name="IconShadow" Opacity="0.45" BlurRadius="20" ShadowDepth="4" Direction="270"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <Canvas Width="64" Height="64">
                        <Path x:Name="IconPath" Stroke="White" StrokeThickness="4.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Canvas>
                </Grid>

                <TextBlock x:Name="TitleText" Style="{StaticResource DialogTitleTextBlockStyle}"
                           HorizontalAlignment="Center" TextAlignment="Center"/>
                <TextBlock x:Name="MessageText" Style="{StaticResource MutedTextBlockStyle}"
                           FontSize="13" LineHeight="20" TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center" Margin="0,0,0,16"/>

                <!-- Lines of the message that start with "• ", eg. the missing articles of an import -->
                <Border x:Name="BulletBox" Background="{StaticResource SidebarBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="12,8" Margin="0,0,0,16" Visibility="Collapsed">
                    <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="BulletList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="•" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextBrush}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- Note with a link, eg. to the Bexio order of a failed import -->
                <TextBlock x:Name="NoteText" Style="{StaticResource MutedTextBlockStyle}"
                           FontSize="13" LineHeight="20" TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center" Margin="0,0,0,16" Visibility="Collapsed"/>

                <!-- Input dialog: text box with the error of the previous input -->
                <Grid Margin="0,0,0,8" Visibility="{Binding Visibility, ElementName=InputBox}">
                    <TextBox x:Name="InputBox" Height="36" Visibility="Collapsed"/>
                    <!-- Example of the expected input, shown while the box is empty -->
                    <TextBlock x:Name="InputPlaceholder" Margin="11,0,0,0" VerticalAlignment="Center"
                               IsHitTestVisible="False" Foreground="{StaticResource TextMutedBrush}" Opacity="0.7">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=InputBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <TextBlock x:Name="InputErrorText" TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{StaticResource ErrorBrush}" Margin="0,0,0,8" Visibility="Collapsed"/>

                <!-- Choice dialog: one button per option -->
                <StackPanel x:Name="ChoicePanel" Visibility="Collapsed"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                    <Button x:Name="CancelButton" Click="CancelButton_Click"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Width="140" Height="36" Margin="0,0,8,0"
                            Visibility="Collapsed"/>
                    <Button x:Name="OkButton" Click="OkButton_Click"
                            Style="{StaticResource ModernButtonStyle}"
                            Width="140" Height="36"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
