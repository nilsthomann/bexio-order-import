<Window x:Class="BexioOrderImport.Wpf.Views.ProfileCreateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lex="clr-namespace:BexioOrderImport.Wpf.Resources"
        Title="{x:Static lex:Translations.Settings_ProfilesCreateTitle}"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        ShowInTaskbar="False">

    <Grid>
        <!-- Backdrop -->
        <Rectangle Fill="{StaticResource DialogBackdropBrush}"/>

        <!-- Dialog Card -->
        <Border Width="440" Style="{StaticResource DialogCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title in the style of the import success dialog, without a title bar -->
                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <TextBlock x:Name="TitleTextBlock" Text="{x:Static lex:Translations.Settings_ProfilesCreateTitle}" Style="{StaticResource DialogTitleTextBlockStyle}"/>
                    <TextBlock Text="{x:Static lex:Translations.Settings_ProfilesCreateHint}" Style="{StaticResource MutedTextBlockStyle}" FontSize="13" TextWrapping="Wrap" Margin="0"/>
                </StackPanel>

                <!-- Body -->
                <StackPanel Grid.Row="2">
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{x:Static lex:Translations.Settings_ProfileNameLabel}"
                                   VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="Medium"/>
                        <TextBox x:Name="ProfileNameInput" Grid.Column="1" Height="36"/>

                        <TextBlock Grid.Row="1" Text="{x:Static lex:Translations.Settings_FormatLabel}"
                                   VerticalAlignment="Center" Margin="0,12,12,0" FontWeight="Medium"/>
                        <ComboBox x:Name="FormatInput" Grid.Row="1" Grid.Column="1" Height="36" Margin="0,12,0,0"
                                  DisplayMemberPath="DisplayName" SelectedValuePath="FormatId"
                                  VerticalContentAlignment="Center"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{x:Static lex:Translations.Dialog_Cancel}" Click="Cancel_Click"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="100" Height="34" Margin="0,0,8,0"/>
                        <Button x:Name="ActionButton" Content="{x:Static lex:Translations.Dialog_Create}"
                                Click="Create_Click"
                                Style="{StaticResource ModernButtonStyle}"
                                Width="100" Height="34"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
