<Window x:Class="BexioOrderImport.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lex="clr-namespace:BexioOrderImport.Wpf.Resources"
        xmlns:helpers="clr-namespace:BexioOrderImport.Wpf.Helpers"
        xmlns:controls="clr-namespace:BexioOrderImport.Wpf.Views.Controls"
        Title="{x:Static lex:Translations.MainWindow_Title}" 
        Height="800" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        WindowState="Maximized"
        Icon="/Resources/app_icon.png">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>
        
        <!-- Left Sidebar Navigation -->
        <Border Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" 
                Background="{StaticResource SidebarBrush}" 
                BorderBrush="{StaticResource BorderBrush}" 
                BorderThickness="0,0,1,0">
            <Grid Margin="16,24,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Brand Logo / Title -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,32" Grid.Row="0">
                    <Border Width="32" Height="32" Background="{StaticResource AccentBrush}" CornerRadius="8" Margin="0,0,12,0">
                        <TextBlock Text="B" Foreground="White" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Bexio Import" Style="{StaticResource HeaderTextBlockStyle}" FontSize="18" Margin="0" VerticalAlignment="Center"/>
                </StackPanel>
                
                <!-- Nav RadioButtons bound to MainViewModel SelectedTabIndex -->
                <StackPanel Grid.Row="1">
                    <RadioButton Content="{x:Static lex:Translations.Nav_Import}" 
                                 IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IndexToBooleanConverter}, ConverterParameter=0, Mode=TwoWay}"
                                 Style="{StaticResource SidebarNavButtonStyle}"/>
                    <RadioButton Content="{x:Static lex:Translations.Nav_Settings}" 
                                 IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IndexToBooleanConverter}, ConverterParameter=1, Mode=TwoWay}"
                                 Style="{StaticResource SidebarNavButtonStyle}"/>
                </StackPanel>
                
                <!-- Footer info in Sidebar -->
                <StackPanel Grid.Row="2">
                    <TextBlock Text="{Binding AppVersion}" Style="{StaticResource MutedTextBlockStyle}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Main Content Area -->
        <Grid Grid.Column="1" Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Update Banner -->
            <Border Grid.Row="0" Background="{StaticResource SelectionBrush}" 
                    BorderBrush="{StaticResource BorderBrush}" 
                    BorderThickness="0,0,0,1" Padding="16,10"
                    Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Left: Info -->
                    <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                        <!-- Update Icon (Arrow Up Circle / Info Icon) -->
                        <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"
                              Fill="{StaticResource AccentBrush}" Stretch="Uniform" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock VerticalAlignment="Center" Foreground="{StaticResource SelectionForegroundBrush}" FontSize="13" FontWeight="Medium">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding UpdateVersion, StringFormat={x:Static lex:Translations.Update_Available}}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDownloadingUpdate}" Value="True">
                                            <Setter Property="Text" Value="{Binding UpdateStatusText}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    
                    <!-- Right: Actions -->
                    <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center">
                        <!-- Progress bar (only visible during download) -->
                        <ProgressBar Value="{Binding UpdateProgress}" Width="120" Height="6" Margin="0,0,16,0" VerticalAlignment="Center"
                                     Visibility="{Binding IsDownloadingUpdate, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        
                        <!-- Install button (hidden during download) -->
                        <Button Content="{x:Static lex:Translations.Update_InstallNow}"
                                Command="{Binding InstallUpdateCommand}"
                                Style="{StaticResource ModernButtonStyle}"
                                Height="28" Padding="12,0" FontSize="11"
                                Visibility="{Binding IsDownloadingUpdate, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TabControl x:Name="MainTabControl" Grid.Row="1" 
                        SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                        BorderThickness="0" Background="Transparent" 
                        ItemContainerStyle="{StaticResource TabItemHiddenStyle}">
            
            <!-- Tab 1: Excel Import -->
            <TabItem Header="Import">
                <controls:ImportControl/>
            </TabItem>
            
            <!-- Tab 2: Settings -->
            <TabItem Header="Settings">
                <controls:SettingsControl/>
            </TabItem>
            
        </TabControl>
        </Grid>
        
        <!-- Bottom Status Bar -->
        <StatusBar Grid.Column="1" Grid.Row="1" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <StatusBarItem HorizontalAlignment="Right" Margin="0,0,12,0">
                <StackPanel Orientation="Horizontal">
                    <!-- Status Indicator Dot -->
                    <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="{x:Type Ellipse}">
                                <Setter Property="Fill" Value="{Binding ConnectionStatusColor, Converter={StaticResource ColorToBrushConverter}}"/>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding ConnectionStatusText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </StatusBarItem>
            </StatusBar>

        <!-- Full Screen Loading & Success Modal Overlay for Bexio API Import -->
        <Grid Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0" Grid.RowSpan="2"
              Visibility="{Binding IsImportingActive, Converter={StaticResource BooleanToVisibilityConverter}}">
            <!-- Semi-transparent backdrop -->
            <Rectangle Fill="#A8000000"/>
            
            <!-- Modal Card -->
            <Border Width="440" MinHeight="260"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource BackgroundBrush}"
                    CornerRadius="16"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    Padding="28">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.35" BlurRadius="40" ShadowDepth="12" Direction="270"/>
                </Border.Effect>
                
                <Grid>
                    <!-- STATE 1: IN PROGRESS (IsImportSuccess == False) -->
                    <Grid Visibility="{Binding IsImportSuccess, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Spinner -->
                        <Control Style="{StaticResource SpinnerStyle}" HorizontalAlignment="Center" Margin="0,0,0,20" Grid.Row="0"/>
                        
                        <!-- Title -->
                        <TextBlock Text="{x:Static lex:Translations.Import_Importing}" 
                                   FontWeight="SemiBold" FontSize="16" 
                                   Foreground="{StaticResource TextBrush}"
                                   HorizontalAlignment="Center" Margin="0,0,0,8" Grid.Row="1"/>
                        
                        <!-- Subtext -->
                        <TextBlock Text="{x:Static lex:Translations.Import_PleaseWait}" 
                                   Style="{StaticResource MutedTextBlockStyle}" 
                                   HorizontalAlignment="Center" Margin="0,0,0,8" Grid.Row="2"/>

                        <!-- Remaining Time Text -->
                        <TextBlock Text="{Binding RemainingTimeText}" 
                                   Style="{StaticResource MutedTextBlockStyle}" 
                                   FontSize="12" FontWeight="Medium"
                                   Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center" Margin="0,0,0,20" Grid.Row="3"
                                   Visibility="{Binding RemainingTimeText, Converter={StaticResource NullToVisibilityConverter}}"/>
                        
                        <!-- Progress Bar -->
                        <ProgressBar Value="{Binding ProgressPercentage}" Height="6" Grid.Row="4" VerticalAlignment="Bottom"/>
                    </Grid>

                    <!-- STATE 2: SUCCESS STATE (IsImportSuccess == True) -->
                    <Grid Visibility="{Binding IsImportSuccess, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Animated Celebration Graphic Container -->
                        <Grid Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,20" Width="100" Height="100">
                            <!-- Sprinkle Particles Burst -->
                            <Canvas x:Name="SprinklesCanvas" Width="100" Height="100" RenderTransformOrigin="0.5,0.5">
                                <Canvas.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                </Canvas.RenderTransform>
                                <Canvas.Style>
                                    <Style TargetType="Canvas">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsImportSuccess}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                             From="0.2" To="1.25" Duration="0:0:0.65"/>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                             From="0.2" To="1.25" Duration="0:0:0.65"/>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             From="0.0" To="1.0" Duration="0:0:0.3" AutoReverse="True"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Canvas.Style>
                                <Ellipse Width="6" Height="6" Fill="#10B981" Canvas.Left="47" Canvas.Top="6"/>
                                <Ellipse Width="7" Height="7" Fill="#3B82F6" Canvas.Left="76" Canvas.Top="18"/>
                                <Ellipse Width="6" Height="6" Fill="#F59E0B" Canvas.Left="86" Canvas.Top="47"/>
                                <Ellipse Width="7" Height="7" Fill="#10B981" Canvas.Left="74" Canvas.Top="76"/>
                                <Ellipse Width="6" Height="6" Fill="#EC4899" Canvas.Left="47" Canvas.Top="86"/>
                                <Ellipse Width="7" Height="7" Fill="#8B5CF6" Canvas.Left="18" Canvas.Top="76"/>
                                <Ellipse Width="6" Height="6" Fill="#10B981" Canvas.Left="8" Canvas.Top="47"/>
                                <Ellipse Width="7" Height="7" Fill="#3B82F6" Canvas.Left="18" Canvas.Top="18"/>
                            </Canvas>

                            <!-- Green Filled Circle with Masked Checkmark -->
                            <Grid Width="64" Height="64" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                </Grid.RenderTransform>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsImportSuccess}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                             From="0.2" To="1.0" Duration="0:0:0.5">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <BackEase EasingMode="EaseOut" Amplitude="0.7"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                             From="0.2" To="1.0" Duration="0:0:0.5">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <BackEase EasingMode="EaseOut" Amplitude="0.7"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <Ellipse Width="64" Height="64">
                                    <Ellipse.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#8B5CF6" Offset="0.0"/>
                                            <GradientStop Color="#6D28D9" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Ellipse.Fill>
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="#7C3AED" Opacity="0.45" BlurRadius="20" ShadowDepth="4" Direction="270"/>
                                    </Ellipse.Effect>
                                </Ellipse>

                                <!-- Perfectly Centered White Masked Checkmark Path -->
                                <Canvas Width="64" Height="64" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="M19,33 L27,41 L45,23" 
                                          Stroke="White" 
                                          StrokeThickness="4.5" 
                                          StrokeStartLineCap="Round" 
                                          StrokeEndLineCap="Round" 
                                          StrokeLineJoin="Round"/>
                                </Canvas>
                            </Grid>
                        </Grid>

                        <!-- Title -->
                        <TextBlock Text="{Binding ImportSuccessTitle}" 
                                   FontWeight="Bold" FontSize="18" 
                                   Foreground="{StaticResource TextBrush}"
                                   HorizontalAlignment="Center" Margin="0,0,0,8" Grid.Row="1"/>
                        
                        <!-- Success Message -->
                        <TextBlock Text="{Binding ImportSuccessMessage}" 
                                   Style="{StaticResource MutedTextBlockStyle}" 
                                   FontSize="13" TextWrapping="Wrap" TextAlignment="Center"
                                   HorizontalAlignment="Center" Margin="0,0,0,8" Grid.Row="2"/>

                        <!-- Duration Text -->
                        <TextBlock Text="{Binding ImportDurationText}" 
                                   FontWeight="SemiBold" FontSize="13"
                                   Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center" Margin="0,0,0,24" Grid.Row="3"/>
                        
                        <!-- Done Button -->
                        <Button Content="{x:Static lex:Translations.Import_DoneButton}" 
                                Command="{Binding CloseImportSuccessCommand}"
                                Style="{StaticResource ModernButtonStyle}" 
                                Width="140" HorizontalAlignment="Center" Grid.Row="4"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
