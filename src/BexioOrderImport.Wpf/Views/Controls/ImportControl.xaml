<UserControl x:Class="BexioOrderImport.Wpf.Views.Controls.ImportControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lex="clr-namespace:BexioOrderImport.Wpf.Resources"
             xmlns:helpers="clr-namespace:BexioOrderImport.Wpf.Helpers">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Title & Active Profile -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Static lex:Translations.Nav_Import}" Style="{StaticResource HeaderTextBlockStyle}" Grid.Column="0" VerticalAlignment="Center"/>
            
            <!-- Active Profile Popover Dropdown -->
            <Grid Grid.Column="1" VerticalAlignment="Center">
                <ToggleButton x:Name="ProfileDropdownButton" ToolTip="{x:Static lex:Translations.Import_ActiveProfileTooltip}" Cursor="Hand">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="BadgeBorder" Background="{StaticResource AccentLightBrush}" CornerRadius="12" Padding="12,4,10,4">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ActiveProfile.Name, FallbackValue='Default'}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <Path Data="M7 10l5 5 5-5z" Fill="{StaticResource AccentBrush}" Stretch="Uniform" Width="10" Height="10" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BadgeBorder" Property="Background" Value="#DBEAFE"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>

                <Popup x:Name="ProfilePopup"
                       IsOpen="{Binding IsChecked, ElementName=ProfileDropdownButton}"
                       PlacementTarget="{Binding ElementName=ProfileDropdownButton}"
                       Placement="Bottom"
                       AllowsTransparency="True"
                       StaysOpen="False"
                       HorizontalOffset="-40"
                       VerticalOffset="4">
                    <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="6" MinWidth="180">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="4" Opacity="0.15" Color="#000000"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="{x:Static lex:Translations.Import_SelectProfileHeader}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="8,4,8,6"/>
                            <ItemsControl ItemsSource="{Binding Profiles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Click="ProfileItem_Click" Margin="0,1" Padding="8,6" HorizontalContentAlignment="Left" Cursor="Hand" Background="Transparent" BorderThickness="0">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextBrush}"/>
                                                            <Path Grid.Column="1" Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" Fill="{StaticResource AccentBrush}" Stretch="Uniform" Width="12" Height="12" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                <Path.Style>
                                                                    <Style TargetType="Path">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Value="True">
                                                                                <DataTrigger.Binding>
                                                                                    <MultiBinding Converter="{StaticResource EqualityConverter}">
                                                                                        <Binding Path="Name"/>
                                                                                        <Binding Path="DataContext.ActiveProfile.Name" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                                                                    </MultiBinding>
                                                                                </DataTrigger.Binding>
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Path.Style>
                                                            </Path>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="#F3F4F6"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Grid>
        
        <!-- File Drag & Drop Zone -->
        <Border Grid.Row="1" Style="{StaticResource DragDropZoneStyle}" 
                AllowDrop="True" DragOver="DropZone_DragOver" Drop="DropZone_Drop"
                MouseDown="DropZone_MouseDown"
                Visibility="{Binding HasLoadedFile, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Path Data="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM14 13v4h-4v-4H7l5-5 5 5h-3z"
                      Fill="{StaticResource AccentBrush}" Stretch="Uniform" Width="48" Height="48" Margin="0,0,0,12"/>
                <TextBlock Text="{x:Static lex:Translations.Import_DragDropText}" FontWeight="Medium" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Loaded File Box -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" 
                Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" 
                Visibility="{Binding HasLoadedFile, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <Path Data="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"
                      Fill="{StaticResource SuccessBrush}" Stretch="Uniform" Width="32" Height="32" Margin="0,0,16,0" Grid.Column="0" VerticalAlignment="Center"/>
                
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedFileName}" FontWeight="SemiBold" FontSize="13"/>
                    <TextBlock Text="{Binding FileSizeText}" Style="{StaticResource MutedTextBlockStyle}"/>
                </StackPanel>
                
                <Button Grid.Column="2" Command="{Binding ClearFileCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" 
                        Width="36" Height="36" Padding="0">
                    <Path Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"
                          Fill="{StaticResource ErrorBrush}" Stretch="Uniform" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </Grid>
        </Border>
        
        <!-- Local Excel File Loading Overlay -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" 
                Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" 
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Control Style="{StaticResource SpinnerStyle}" Margin="0,0,0,16"/>
                <TextBlock Text="{x:Static lex:Translations.Import_LoadingExcel}" FontWeight="Medium" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
        
        <!-- Order metadata / Header preview -->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Visibility="{Binding SelectedFilePath, Converter={StaticResource NullToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <TextBlock Text="{x:Static lex:Translations.Import_OrderHeader}" Style="{StaticResource SectionHeaderTextBlockStyle}" Grid.Row="0"/>
                
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,4">
                        <TextBlock Text="{x:Static lex:Translations.Import_Customer}" Style="{StaticResource MutedTextBlockStyle}"/>
                        <TextBlock Text="{Binding CompanyName}" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,4">
                        <TextBlock Text="{x:Static lex:Translations.Import_Address}" Style="{StaticResource MutedTextBlockStyle}"/>
                        <TextBlock Text="{Binding Address}" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Grid.Row="0" Margin="0,4">
                        <TextBlock Text="{x:Static lex:Translations.Import_Email}" Style="{StaticResource MutedTextBlockStyle}"/>
                        <TextBlock Text="{Binding Email}" FontWeight="SemiBold"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,4">
                        <TextBlock Text="{x:Static lex:Translations.Import_Buyer}" Style="{StaticResource MutedTextBlockStyle}"/>
                        <TextBlock Text="{Binding BuyerName}" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Grid.Row="1" Margin="0,4">
                        <TextBlock Text="{x:Static lex:Translations.Import_Conditions}" Style="{StaticResource MutedTextBlockStyle}"/>
                        <TextBlock Text="{Binding PaymentTerms}" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Grid.Row="1" Margin="0,4">
                        <TextBlock Text="{x:Static lex:Translations.Import_OrderNumber}" Style="{StaticResource MutedTextBlockStyle}"/>
                        <TextBlock Text="{Binding OrderNumber}" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Grid.Row="1" Margin="0,4">
                        <TextBlock Text="{x:Static lex:Translations.Import_CustomerNumber}" Style="{StaticResource MutedTextBlockStyle}"/>
                        <TextBlock Text="{Binding CustomerNumber}" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
        
        <!-- DataGrid Preview & Console Logs -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Left pane: Grid -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0">
                <Grid>
                    <Grid.Resources>
                        <helpers:BindingProxy x:Key="Proxy" Data="{Binding}"/>
                    </Grid.Resources>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Text="{x:Static lex:Translations.Import_PositionsHeader}" Style="{StaticResource SectionHeaderTextBlockStyle}" Grid.Row="0"/>
                    
                    <DataGrid ItemsSource="{Binding OrderPositions}" Grid.Row="1" 
                              CanUserReorderColumns="False" CanUserResizeColumns="False"
                              CanUserSortColumns="False"
                              Focusable="False"
                              CellEditEnding="DataGrid_CellEditEnding">
                        <DataGrid.ItemContainerStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Focusable" Value="False"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.ItemContainerStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                <Setter Property="Focusable" Value="False"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                             <DataGridTextColumn Header="{x:Static lex:Translations.Import_ColArtNum}" Binding="{Binding ArticleNumber, UpdateSourceTrigger=PropertyChanged}" Width="70" IsReadOnly="True" ElementStyle="{StaticResource DataGridCellTextBlockStyle}"/>
                             <DataGridTextColumn Header="{x:Static lex:Translations.Import_ColName}" Binding="{Binding ArticleName, UpdateSourceTrigger=PropertyChanged}" Width="2*" IsReadOnly="True" ElementStyle="{StaticResource DataGridCellTextBlockStyle}"/>
                             <DataGridTextColumn Header="{x:Static lex:Translations.Import_ColColor}" Binding="{Binding Color, UpdateSourceTrigger=PropertyChanged}" Width="110" IsReadOnly="True" ElementStyle="{StaticResource DataGridCellTextBlockStyle}"/>
                             <DataGridTextColumn Header="{x:Static lex:Translations.Import_ColCategory}" Binding="{Binding SizeCategory, UpdateSourceTrigger=PropertyChanged}" Width="100" IsReadOnly="True" ElementStyle="{StaticResource DataGridCellTextBlockStyle}"/>
                             <DataGridTemplateColumn Header="{x:Static lex:Translations.Import_ColSize}" Width="120">
                                 <DataGridTemplateColumn.CellTemplate>
                                     <DataTemplate>
                                         <Grid Background="Transparent" 
                                               ToolTip="{Binding Size, Converter={StaticResource HtmlToNewLineConverter}}" 
                                               HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                             <TextBlock Text="{Binding Size, Converter={StaticResource HtmlToNewLineConverter}}" 
                                                        TextWrapping="Wrap" 
                                                        VerticalAlignment="Center" 
                                                        Margin="4,2"/>
                                         </Grid>
                                     </DataTemplate>
                                 </DataGridTemplateColumn.CellTemplate>
                             </DataGridTemplateColumn>
                             <DataGridTextColumn Header="{x:Static lex:Translations.Import_ColQuantity}" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="70" IsReadOnly="True" ElementStyle="{StaticResource DataGridCellTextBlockStyle}"/>
                             <DataGridTextColumn Header="{x:Static lex:Translations.Import_ColUnitPrice}" Binding="{Binding UnitPrice, StringFormat=F2}" Width="95" IsReadOnly="True" ElementStyle="{StaticResource DataGridCellTextBlockStyle}"
                                                 Visibility="{Binding Data.IsActiveRowDiscountEnabled, Source={StaticResource Proxy}, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                             <DataGridTextColumn Header="{x:Static lex:Translations.Import_ColGrossPrice}" Binding="{Binding GrossUnitPrice, StringFormat=F2}" Width="85" IsReadOnly="True" ElementStyle="{StaticResource DataGridCellTextBlockStyle}"
                                                 Visibility="{Binding Data.IsActiveRowDiscountEnabled, Source={StaticResource Proxy}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                             <DataGridTextColumn Header="{x:Static lex:Translations.Import_ColDiscount}" Binding="{Binding DiscountPercent, StringFormat=G}" Width="75" IsReadOnly="True" ElementStyle="{StaticResource DataGridCellTextBlockStyle}"
                                                 Visibility="{Binding Data.IsActiveRowDiscountEnabled, Source={StaticResource Proxy}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                             <DataGridTextColumn Header="{x:Static lex:Translations.Import_ColNetPrice}" Binding="{Binding NetUnitPrice, StringFormat=F2}" Width="85" IsReadOnly="True" ElementStyle="{StaticResource DataGridCellTextBlockStyle}"
                                                 Visibility="{Binding Data.IsActiveRowDiscountEnabled, Source={StaticResource Proxy}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                             <DataGridTextColumn Header="{x:Static lex:Translations.Import_ColTotalPrice}" Binding="{Binding TotalPrice, StringFormat=F2, Mode=OneWay}" Width="95" ElementStyle="{StaticResource DataGridCellTextBlockStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
            
            <!-- Right pane: Console Logs -->
            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="12,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Text="{x:Static lex:Translations.Import_LogHeader}" Style="{StaticResource SectionHeaderTextBlockStyle}" Grid.Row="0"/>
                    
                    <TextBox Text="{Binding LogText, Mode=OneWay}" Grid.Row="1" 
                             Style="{StaticResource ConsoleTextBoxStyle}"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             x:Name="LogTextBox" TextChanged="LogTextBox_TextChanged"/>
                </Grid>
            </Border>
        </Grid>
        
        <!-- Progress & Actions -->
        <StackPanel Grid.Row="4" Margin="0,16,0,0" Orientation="Vertical">
            <Grid Visibility="{Binding IsImporting, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ProgressBar Value="{Binding ProgressPercentage}" Height="6" Grid.Row="0" Margin="0,0,0,6"/>
                <TextBlock Text="{Binding RemainingTimeText}" Style="{StaticResource MutedTextBlockStyle}" FontSize="12" HorizontalAlignment="Right" Grid.Row="1"/>
            </Grid>
            
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                    
                <!-- Summary Panel -->
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,24,0" Padding="12" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left" Visibility="{Binding HasLoadedFile, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Text="Artikel:" FontWeight="Medium" Foreground="{StaticResource TextMutedBrush}" Grid.Column="0" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding TotalQuantity}" FontWeight="SemiBold" Grid.Column="1"/>
                        
                        <TextBlock Text="Brutto:" FontWeight="Medium" Foreground="{StaticResource TextMutedBrush}" Grid.Column="2" Margin="16,0,6,0"/>
                        <TextBlock Text="{Binding TotalGrossAmount, StringFormat={}{0:F2} CHF}" FontWeight="SemiBold" Grid.Column="3"/>
                        
                        <TextBlock Text="Rabatt:" FontWeight="Medium" Foreground="{StaticResource TextMutedBrush}" Grid.Column="4" Margin="16,0,6,0"/>
                        <TextBlock Text="{Binding DiscountPercentVal, StringFormat={}{0}%}" FontWeight="SemiBold" Foreground="{StaticResource ErrorBrush}" Grid.Column="5"/>
                        
                        <TextBlock Text="Netto:" FontWeight="Bold" Grid.Column="6" Margin="16,0,6,0"/>
                        <TextBlock Text="{Binding TotalNetAmount, StringFormat={}{0:F2} CHF}" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Grid.Column="7"/>
                    </Grid>
                </Border>
                
                <Button Content="{x:Static lex:Translations.Import_UploadButton}" 
                        Command="{Binding ImportCommand}"
                        Style="{StaticResource ModernButtonStyle}" 
                        Width="220" Grid.Column="1"
                        VerticalAlignment="Center"/>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
