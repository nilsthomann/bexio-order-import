<Window x:Class="BexioOrderImport.Wpf.Views.ProfileEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lex="clr-namespace:BexioOrderImport.Wpf.Resources"
        Title="{x:Static lex:Translations.Settings_ProfilesEditTitle}"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        ShowInTaskbar="False">

    <Grid>
        <!-- Backdrop -->
        <Rectangle Fill="#99000000"/>

        <!-- Dialog Card — fixed width, auto height, centred, max height bounded -->
        <Border Width="1000"
                MaxHeight="820"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource BackgroundBrush}"
                CornerRadius="12"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.25" BlurRadius="32" ShadowDepth="8" Direction="270"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" CornerRadius="12,12,0,0" Padding="20,14"
                        Background="{StaticResource SidebarBrush}">
                    <Grid>
                        <TextBlock x:Name="TitleTextBlock"
                                   Text="{x:Static lex:Translations.Settings_ProfilesEditTitle}"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"
                                   VerticalAlignment="Center"/>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                Click="Cancel_Click"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="28" Height="28" Padding="0" BorderThickness="0"
                                ToolTip="Schliessen">
                            <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                                  Fill="{StaticResource TextMutedBrush}" Stretch="Uniform" Width="12" Height="12"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Separator -->
                <Border Grid.Row="1" Height="1" Background="{StaticResource BorderBrush}"/>

                <!-- Scrollable Content -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="20,16,20,0">
                    <StackPanel>
                        <!-- Profile name and format (the format can't be changed) -->
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Static lex:Translations.Settings_ProfileNameLabel}" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="Medium"/>
                                    <TextBox x:Name="ProfileNameInput" Grid.Column="1" Height="32" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Static lex:Translations.Settings_FormatLabel}" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="Medium"/>
                                    <ComboBox x:Name="FormatInput" Grid.Column="1" Height="32" Width="300" HorizontalAlignment="Left"
                                              DisplayMemberPath="DisplayName" IsEnabled="False" VerticalContentAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Settings of the format -->
                        <ContentControl x:Name="FormatSettingsHost" Focusable="False"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Bottom Separator -->
                <Border Grid.Row="3" Height="1" Background="{StaticResource BorderBrush}" Margin="0,16,0,0"/>

                <!-- Footer Buttons -->
                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,12,20,16">
                    <Button Content="{x:Static lex:Translations.Dialog_Cancel}" Click="Cancel_Click"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Width="110" Height="34" Margin="0,0,8,0"/>
                    <Button Content="{x:Static lex:Translations.Dialog_Save}" Click="Save_Click"
                            Style="{StaticResource ModernButtonStyle}"
                            Width="110" Height="34"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
