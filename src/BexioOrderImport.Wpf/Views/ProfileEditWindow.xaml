<Window x:Class="BexioOrderImport.Wpf.Views.ProfileEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lex="clr-namespace:BexioOrderImport.Wpf.Resources"
        Title="{x:Static lex:Translations.Settings_ProfilesEditTitle}"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        ShowInTaskbar="False">

    <Grid>
        <!-- Backdrop -->
        <Rectangle Fill="{StaticResource DialogBackdropBrush}"/>

        <!-- Dialog Card — fixed width, auto height, centred, max height bounded -->
        <Border Width="1000" MaxHeight="820" Style="{StaticResource DialogCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title in the style of the import success dialog, without a title bar -->
                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <TextBlock x:Name="TitleTextBlock" Text="{x:Static lex:Translations.Settings_ProfilesEditTitle}" Style="{StaticResource DialogTitleTextBlockStyle}"/>
                    <TextBlock Text="{x:Static lex:Translations.Settings_ProfilesEditHint}" Style="{StaticResource MutedTextBlockStyle}" FontSize="13" TextWrapping="Wrap" Margin="0"/>
                </StackPanel>

                <!-- Scrollable Content -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Profile name and format (the format can't be changed) -->
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Static lex:Translations.Settings_ProfileNameLabel}" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="Medium"/>
                                    <TextBox x:Name="ProfileNameInput" Grid.Column="1" Height="32" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Static lex:Translations.Settings_FormatLabel}" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="Medium"/>
                                    <ComboBox x:Name="FormatInput" Grid.Column="1" Height="32" Width="300" HorizontalAlignment="Left"
                                              DisplayMemberPath="DisplayName" IsEnabled="False" VerticalContentAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Settings of the format -->
                        <ContentControl x:Name="FormatSettingsHost" Focusable="False"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer Buttons -->
                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button Content="{x:Static lex:Translations.Dialog_Cancel}" Click="Cancel_Click"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Width="110" Height="34" Margin="0,0,8,0"/>
                    <Button Content="{x:Static lex:Translations.Dialog_Save}" Click="Save_Click"
                            Style="{StaticResource ModernButtonStyle}"
                            Width="110" Height="34"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
