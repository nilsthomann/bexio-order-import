<Application x:Class="BexioOrderImport.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Styles and converters, shared with the format controls -->
                <ResourceDictionary Source="pack://application:,,,/BexioOrderImport.Abstractions.Wpf;component/Styles/AppStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Style to hide TabControl headers for navigation -->
            <Style x:Key="TabItemHiddenStyle" TargetType="{x:Type TabItem}">
                <Setter Property="Visibility" Value="Collapsed"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
