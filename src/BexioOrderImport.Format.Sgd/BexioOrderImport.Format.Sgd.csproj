  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>BexioOrderImport.Format.Sgd.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

