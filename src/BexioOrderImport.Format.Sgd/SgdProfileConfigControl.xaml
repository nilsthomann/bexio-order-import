<UserControl x:Class="BexioOrderImport.Format.Sgd.SgdProfileConfigControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:BexioOrderImport.Format.Sgd.Resources">
    <UserControl.Resources>
        <!-- BasedOn keeps the theme style (rounded border), this only sets the height -->
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="32"/>
        </Style>
    </UserControl.Resources>

    <StackPanel>

        <!-- 1. Profile information -->
        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{x:Static res:SgdTranslations.Settings_ProfileSection}" Style="{StaticResource SectionHeaderTextBlockStyle}"/>

                <Grid Margin="0,8,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static res:SgdTranslations.Settings_WorksheetLabel}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBox Grid.Column="1" Text="{Binding WorksheetIndex, UpdateSourceTrigger=PropertyChanged}" Width="100" HorizontalAlignment="Left"/>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{x:Static res:SgdTranslations.Settings_StartRowLabel}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBox Grid.Column="1" Text="{Binding StartRow, UpdateSourceTrigger=PropertyChanged}" Width="100" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Static res:SgdTranslations.Settings_StartRowHint}"
                               Style="{StaticResource MutedTextBlockStyle}" FontStyle="Italic" Margin="0,4,0,0"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{x:Static res:SgdTranslations.Settings_DiscountLabel}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBox Grid.Column="1" Text="{Binding DiscountPercent, UpdateSourceTrigger=PropertyChanged}" Width="100" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Static res:SgdTranslations.Settings_DiscountHint}"
                               Style="{StaticResource MutedTextBlockStyle}" FontStyle="Italic" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 2. Excel columns -->
        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{x:Static res:SgdTranslations.Settings_ColumnsSection}" Style="{StaticResource SectionHeaderTextBlockStyle}"/>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="{x:Static res:SgdTranslations.Settings_ArticleNumberColumn}" Style="{StaticResource MutedTextBlockStyle}" TextTrimming="CharacterEllipsis"/>
                        <TextBox Text="{Binding ArticleNumberColumn, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="{x:Static res:SgdTranslations.Settings_ArticleNameColumn}" Style="{StaticResource MutedTextBlockStyle}" TextTrimming="CharacterEllipsis"/>
                        <TextBox Text="{Binding ArticleNameColumn, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                        <TextBlock Text="{x:Static res:SgdTranslations.Settings_ColorColumn}" Style="{StaticResource MutedTextBlockStyle}" TextTrimming="CharacterEllipsis"/>
                        <TextBox Text="{Binding ColorColumn, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="0,0,8,0">
                        <TextBlock Text="{x:Static res:SgdTranslations.Settings_SizeColumn}" Style="{StaticResource MutedTextBlockStyle}" TextTrimming="CharacterEllipsis"/>
                        <TextBox Text="{Binding SizeColumn, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="{x:Static res:SgdTranslations.Settings_QuantityColumn}" Style="{StaticResource MutedTextBlockStyle}" TextTrimming="CharacterEllipsis"/>
                        <TextBox Text="{Binding QuantityColumn, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <CheckBox x:Name="UseExternalOrderNumberColumnCheckBox" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                              Content="{x:Static res:SgdTranslations.Settings_UseExternalOrderNumberColumn}"
                              IsChecked="{Binding UseExternalOrderNumberColumn}"
                              VerticalAlignment="Center" Margin="0,24,8,0"
                              Foreground="{StaticResource TextBrush}" FontWeight="Medium"/>
                    <StackPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Margin="0,8,8,0">
                        <TextBlock Text="{x:Static res:SgdTranslations.Settings_ExternalOrderNumberColumn}" Style="{StaticResource MutedTextBlockStyle}" TextTrimming="CharacterEllipsis"/>
                        <TextBox Text="{Binding ExternalOrderNumberColumn, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding ElementName=UseExternalOrderNumberColumnCheckBox, Path=IsChecked}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="4" Margin="0,8,0,0">
                        <TextBlock Text="{x:Static res:SgdTranslations.Settings_SeasonColumn}" Style="{StaticResource MutedTextBlockStyle}" TextTrimming="CharacterEllipsis"/>
                        <TextBox Text="{Binding SeasonColumn, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="{x:Static res:SgdTranslations.Settings_RowsHint}" Style="{StaticResource MutedTextBlockStyle}"
                           FontStyle="Italic" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- 3. Season mapping: SGD season name to Bexio season code -->
        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{x:Static res:SgdTranslations.Settings_SeasonMappingSection}" Style="{StaticResource SectionHeaderTextBlockStyle}"/>
                <TextBlock Text="{x:Static res:SgdTranslations.Settings_SeasonMappingHint}" Style="{StaticResource MutedTextBlockStyle}"
                           FontStyle="Italic" TextWrapping="Wrap" Margin="0,4,0,8"/>

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static res:SgdTranslations.Settings_ExternalSeasonLabel}" Style="{StaticResource MutedTextBlockStyle}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1" Text="{x:Static res:SgdTranslations.Settings_SeasonCodeLabel}" Style="{StaticResource MutedTextBlockStyle}" TextTrimming="CharacterEllipsis" Margin="8,0,0,0"/>
                </Grid>

                <ItemsControl ItemsSource="{Binding SeasonMappings}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding ExternalSeason, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="{x:Static res:SgdTranslations.Settings_ExternalSeasonLabel}"/>
                                <TextBox Grid.Column="1" Text="{Binding SeasonCode, UpdateSourceTrigger=PropertyChanged}" Margin="8,0,0,0"
                                         AutomationProperties.Name="{x:Static res:SgdTranslations.Settings_SeasonCodeLabel}"/>
                                <Button Grid.Column="2" Command="{Binding DataContext.RemoveSeasonMappingCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="{x:Static res:SgdTranslations.Settings_RemoveSeasonMapping}"
                                        AutomationProperties.Name="{x:Static res:SgdTranslations.Settings_RemoveSeasonMapping}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Width="32" Height="32" Padding="0" BorderThickness="0" HorizontalAlignment="Right">
                                    <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                                          Fill="{StaticResource TextMutedBrush}" Stretch="Uniform" Width="12" Height="12"/>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- New mapping: the plus button is enabled once both inputs are filled -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding NewExternalSeason, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="{x:Static res:SgdTranslations.Settings_ExternalSeasonLabel}"/>
                    <TextBox Grid.Column="1" Text="{Binding NewSeasonCode, UpdateSourceTrigger=PropertyChanged}" Margin="8,0,0,0"
                             AutomationProperties.Name="{x:Static res:SgdTranslations.Settings_SeasonCodeLabel}"/>
                    <Button Grid.Column="2" Command="{Binding AddSeasonMappingCommand}"
                            ToolTip="{x:Static res:SgdTranslations.Settings_AddSeasonMapping}"
                            ToolTipService.ShowOnDisabled="True"
                            AutomationProperties.Name="{x:Static res:SgdTranslations.Settings_AddSeasonMapping}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Width="32" Height="32" Padding="0" HorizontalAlignment="Right">
                        <Path Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"
                              Fill="{StaticResource AccentBrush}" Stretch="Uniform" Width="12" Height="12"/>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 4. Texts and templates -->
        <Border Style="{StaticResource CardBorderStyle}">
            <StackPanel>
                <TextBlock Text="{x:Static res:SgdTranslations.Settings_TextTemplatesSection}" Style="{StaticResource SectionHeaderTextBlockStyle}"/>

                <StackPanel Margin="0,8,0,12">
                    <TextBlock Text="{x:Static res:SgdTranslations.Settings_DefaultOrderNameLabel}" Margin="0,0,0,4" FontWeight="Medium"/>
                    <TextBox Text="{Binding DefaultOrderName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>
                    <TextBlock Text="{x:Static res:SgdTranslations.Settings_DefaultOrderNameHint}" Style="{StaticResource MutedTextBlockStyle}" FontStyle="Italic"/>
                </StackPanel>

                <!-- Position grouping (segmented control) -->
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="{x:Static res:SgdTranslations.Settings_PositionGroupingModeLabel}" Margin="0,0,0,6" FontWeight="Medium"/>
                    <Border HorizontalAlignment="Stretch" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                            CornerRadius="6" Background="Transparent" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <RadioButton Grid.Column="0"
                                         Content="{x:Static res:SgdTranslations.Settings_PositionGroupingSingle}"
                                         GroupName="SgdPositionGroupingModeGroup"
                                         IsChecked="{Binding IsSinglePosition}"
                                         Style="{StaticResource SegmentedRadioButtonLeftStyle}"/>
                            <Rectangle Grid.Column="1" Fill="{StaticResource AccentBrush}"/>
                            <RadioButton Grid.Column="2"
                                         Content="{x:Static res:SgdTranslations.Settings_PositionGroupingGrouped}"
                                         GroupName="SgdPositionGroupingModeGroup"
                                         IsChecked="{Binding IsGroupedPositions}"
                                         Style="{StaticResource SegmentedRadioButtonRightStyle}"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Single position template -->
                <StackPanel Margin="0,0,0,12" Visibility="{Binding IsGroupedPositions, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <TextBlock Text="{x:Static res:SgdTranslations.Settings_PositionTextTemplateLabel}" Margin="0,0,0,4" FontWeight="Medium"/>
                    <TextBox Text="{Binding SinglePositionTextTemplate, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>
                    <TextBlock Text="{x:Static res:SgdTranslations.Settings_SinglePositionTextTemplateHint}" Style="{StaticResource MutedTextBlockStyle}" FontStyle="Italic" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Grouped position templates -->
                <StackPanel Margin="0,0,0,12" Visibility="{Binding IsGroupedPositions, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="{x:Static res:SgdTranslations.Settings_PositionTextTemplateLabel}" Margin="0,0,0,4" FontWeight="Medium"/>
                        <TextBox Text="{Binding GroupedPositionTextTemplate, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>
                        <TextBlock Text="{x:Static res:SgdTranslations.Settings_GroupedPositionTextTemplateHint}" Style="{StaticResource MutedTextBlockStyle}" FontStyle="Italic" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{x:Static res:SgdTranslations.Settings_SizeRowTemplateLabel}" Margin="0,0,0,4" FontWeight="Medium"/>
                        <TextBox Text="{Binding SizeRowTemplate, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>
                        <TextBlock Text="{x:Static res:SgdTranslations.Settings_SizeRowTemplateHint}" Style="{StaticResource MutedTextBlockStyle}" FontStyle="Italic"/>
                    </StackPanel>
                </StackPanel>

                <!-- Discount position template -->
                <StackPanel Margin="0,0,0,4">
                    <TextBlock Text="{x:Static res:SgdTranslations.Settings_DiscountPositionTextTemplateLabel}" Margin="0,0,0,4" FontWeight="Medium"/>
                    <TextBox Text="{Binding DiscountPositionTextTemplate, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>
                    <TextBlock Text="{x:Static res:SgdTranslations.Settings_DiscountPositionTextTemplateHint}" Style="{StaticResource MutedTextBlockStyle}" FontStyle="Italic"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
