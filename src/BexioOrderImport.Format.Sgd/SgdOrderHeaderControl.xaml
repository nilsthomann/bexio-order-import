<UserControl x:Class="BexioOrderImport.Format.Sgd.SgdOrderHeaderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:BexioOrderImport.Format.Sgd.Resources">
    <!-- Profile values of the order. The import page spaces the views, so the card has no margin -->
    <Border Style="{StaticResource CardBorderStyle}" Margin="0">
        <StackPanel>
            <TextBlock Text="{x:Static res:SgdTranslations.Preview_Header}" Style="{StaticResource SectionHeaderTextBlockStyle}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,4">
                    <TextBlock Text="{x:Static res:SgdTranslations.Preview_SeasonCode}" Style="{StaticResource MutedTextBlockStyle}"/>
                    <TextBlock Text="{Binding SeasonCode}" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,4">
                    <TextBlock Text="{x:Static res:SgdTranslations.Preview_Discount}" Style="{StaticResource MutedTextBlockStyle}"/>
                    <TextBlock Text="{Binding Discount}" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
            <TextBlock Text="{x:Static res:SgdTranslations.Preview_CustomerHint}" Style="{StaticResource MutedTextBlockStyle}"
                       FontStyle="Italic" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>
    </Border>
</UserControl>
