<UserControl x:Class="BexioOrderImport.Format.EanList.EanListPreviewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:BexioOrderImport.Format.EanList.Resources">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Customer and order -->
        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{x:Static res:EanListTranslations.Preview_Header}" Style="{StaticResource SectionHeaderTextBlockStyle}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,4">
                        <TextBlock Text="{x:Static res:EanListTranslations.Preview_CustomerNumber}" Style="{StaticResource MutedTextBlockStyle}"/>
                        <TextBlock Text="{Binding CustomerNumber}" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,4">
                        <TextBlock Text="{x:Static res:EanListTranslations.Preview_OrderNumber}" Style="{StaticResource MutedTextBlockStyle}"/>
                        <TextBlock Text="{Binding OrderNumber}" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="{Binding CustomerNumberMissingMessage}" Foreground="{StaticResource ErrorBrush}" FontWeight="SemiBold"
                           TextWrapping="Wrap" Margin="0,8,0,0"
                           Visibility="{Binding IsCustomerNumberMissing, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
        </Border>

        <!-- Positions and totals -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="{x:Static res:EanListTranslations.Preview_PositionsHeader}" Style="{StaticResource SectionHeaderTextBlockStyle}" Grid.Row="0"/>

                <DataGrid ItemsSource="{Binding Positions}" Grid.Row="1"
                          IsReadOnly="True"
                          CanUserReorderColumns="False" CanUserResizeColumns="False"
                          CanUserSortColumns="False"
                          Focusable="False">
                    <DataGrid.ItemContainerStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Focusable" Value="False"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.ItemContainerStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{x:Static res:EanListTranslations.Preview_ColRow}" Binding="{Binding SourceRow}" Width="70" ElementStyle="{StaticResource DataGridCellTextBlockStyle}"/>
                        <DataGridTextColumn Header="{x:Static res:EanListTranslations.Preview_ColEan}" Binding="{Binding Ean}" Width="*" ElementStyle="{StaticResource DataGridCellTextBlockStyle}"/>
                        <DataGridTextColumn Header="{x:Static res:EanListTranslations.Preview_ColQuantity}" Binding="{Binding Quantity}" Width="90" ElementStyle="{StaticResource DataGridCellTextBlockStyle}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{x:Static res:EanListTranslations.Preview_Positions}" FontWeight="Medium" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding Positions.Count}" FontWeight="SemiBold"/>

                        <TextBlock Text="{x:Static res:EanListTranslations.Preview_TotalQuantity}" FontWeight="Medium" Foreground="{StaticResource TextMutedBrush}" Margin="16,0,6,0"/>
                        <TextBlock Text="{Binding TotalQuantity}" FontWeight="SemiBold"/>

                        <TextBlock Text="{x:Static res:EanListTranslations.Preview_SkippedRows}" FontWeight="Medium" Foreground="{StaticResource TextMutedBrush}" Margin="16,0,6,0"/>
                        <TextBlock Text="{Binding SkippedRows}" FontWeight="SemiBold"/>
                    </StackPanel>
                    <TextBlock Text="{x:Static res:EanListTranslations.Preview_PricesHint}" Style="{StaticResource MutedTextBlockStyle}" FontStyle="Italic" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
